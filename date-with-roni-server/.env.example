# cp .env.example .env  ואז למלא. הקובץ .env לא נכנס לגיט.

# ---- ה-DB ----
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# חובה. ליצור סיסמה אקראית:
#   openssl rand -base64 32
# שים לב: תו $ בסיסמה צריך להיכתב כאן כ-$$ (compose מפרש אותו).
POSTGRES_PASSWORD=

# ---- פיתוח מקומי ----
# מול ה-DB שבשרת דרך ./dev-tunnel.sh, או מול db מקומי.
# בתוך הקונטיינר compose מגדיר את אלה בעצמו, והמארח הוא db ולא localhost.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=

# ---- כניסה עם גוגל ----
# ה-Client ID מ-Google Cloud Console. לא סוד — הוא מופיע גם
# בדף עצמו — אבל השרת חייב אותו כדי לאמת שה-token הונפק *לנו*.
# בלי זה /api/login מחזיר 503.
GOOGLE_CLIENT_ID=

# ---- הסוכן ----
ANTHROPIC_API_KEY=
# נדרש רק אם המפתח מקושר-זהות. אחרת להשאיר ריק.
ANTHROPIC_WORKSPACE_ID=

# שני הדרגות על אותו מודל כברירת מחדל: הדרגה מתורגמת ל-effort
# ולא לשם מודל. שווה להפריד רק כשיהיו סוכני עזר זולים.
#   ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_FAST=claude-opus-5
ANTHROPIC_MODEL_SMART=claude-opus-5

# ---- וואטסאפ ----
# פורמט בינלאומי, בלי + ובלי אפס מוביל. למשל 972501234567
RONI_WHATSAPP_NUMBER=

# תיקיית התמונות. בקונטיינר צריך לחבר אותה כ-volume.
PHOTOS_DIR=photos
